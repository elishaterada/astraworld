# Public endpoint list is frozen into the Next.js browser bundle at build time.
NEXT_PUBLIC_GAME_GATEWAYS=http://127.0.0.1:3101,http://127.0.0.1:3102
# Server only. The standalone runner reads process environment, not Next .env files.
REDIS_URL=redis://127.0.0.1:6380
GAME_NAMESPACE=local:astraworld
WEB_ORIGINS=http://127.0.0.1:3002,http://localhost:3002
GAME_PORT=3101
GATEWAY_ID=local-a
# Set 60000 for the local rotation exercise; unset for ordinary play.
ROTATION_MS=60000
