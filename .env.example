# npm run dev supplies Portless gateway URLs and origins automatically.
# Values below are for the optional standalone fixed-port workflow.
# Public endpoint list is frozen into the Next.js browser bundle at build time.
NEXT_PUBLIC_GAME_GATEWAYS=http://127.0.0.1:3103,http://127.0.0.1:3104
# Server only. The standalone runner reads process environment, not Next .env files.
REDIS_URL=redis://127.0.0.1:6380
GAME_NAMESPACE=local:astraworld-v2-p8-c4-m6
WEB_ORIGINS=http://127.0.0.1:3002,http://localhost:3002
GAME_PORT=3103
GATEWAY_ID=local-a
# Short socket lifetime for local renewal tests; default is 240000 ms.
SOCKET_AGE_MS=20000

# Server-only durable storage; never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://127.0.0.1:55432/astraworld
